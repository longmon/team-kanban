root = Stack([title, kpis, chartCard, pieCard, feedback])
title = TextContent("2026 Q3 运营报告", "large-heavy")
kpis = SnippetCardBlock([k1, k2, k3])
k1 = SnippetCardItem("revenue", k1l, k1r)
k1l = IconText(Icon("circle-dollar-sign", "finance"), "neutral", "m", "营收", "季度累计", false, "horizontal")
k1r = BoldText("number", "¥1,284,000", "+12.4%", "metric")
k2 = SnippetCardItem("users", k2l, k2r)
k2l = IconText(Icon("users", "people"), "neutral", "m", "活跃用户", "9 月", false, "horizontal")
k2r = BoldText("number", "38,210", "+5.1%", "metric")
k3 = SnippetCardItem("churn", k3l, k3r)
k3l = IconText(Icon("user-minus", "people"), "neutral", "m", "流失率", "9 月", false, "horizontal")
k3r = BoldText("number", "2.3%", "-0.4%", "metric")
chartCard = Card([CardHeader("月度营收（万元）", "按产品线"), bar])
bar = BarChart(["7 月", "8 月", "9 月"], [s1, s2], "grouped")
s1 = Series("企业版", [32, 38, 41])
s2 = Series("个人版", [5, 6, 6.4])
pieCard = Card([CardHeader("渠道占比"), pie])
pie = PieChart(["直销", "代理", "线上"], [52, 28, 20], "donut")
feedback = Form("feedback", fbBtns, [scoreField, noteField])
scoreField = FormControl("这份报告对你有帮助吗？", Chips("score", "single", [c1, c2, c3]))
c1 = ChipItem("good", "有帮助")
c2 = ChipItem("ok", "一般")
c3 = ChipItem("bad", "没帮助")
noteField = FormControl("补充意见", TextArea("note", "可选", 2))
fbBtns = Buttons([Button("提交反馈", @ToAssistant("提交反馈"), "primary")])
