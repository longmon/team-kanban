root = Stack([title, intro, form])
title = TextContent("技术选型投票：消息队列", "large-heavy")
intro = TextContent("请选择你认为最适合本项目的方案，并简单说明理由。每次点击「提交」记一票。")
form = Form("vote", btns, [choiceField, commentField])
choiceField = FormControl("方案", RadioGroup("choice", [optA, optB, optC], null, { required: true }))
optA = RadioItem("A. Kafka", "吞吐高，运维成本高", "A")
optB = RadioItem("B. NATS", "轻量，部署简单", "B")
optC = RadioItem("C. PostgreSQL LISTEN/NOTIFY", "无新组件，规模受限", "C")
commentField = FormControl("理由", TextArea("comment", "可选", 3), "可以不填")
btns = Buttons([Button("提交", @ToAssistant("提交"), "primary")])
